BOT_TOKEN=123456:ABC-DEF...

# Base URL of the vdownloader worker (file server + REST API on the same port).
WORKER_URL=http://localhost:8080

# Kafka brokers/topics. KAFKA_JOBS_TOPIC is where the bot publishes download
# job requests; KAFKA_TOPIC is where the worker publishes completed file IDs.
KAFKA_BROKERS=localhost:9092
KAFKA_JOBS_TOPIC=video.jobs
KAFKA_TOPIC=video.completed
