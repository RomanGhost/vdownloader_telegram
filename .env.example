BOT_TOKEN=123456:ABC-DEF...

# Base URL of the vdownloader worker (file server + REST API on the same port).
WORKER_URL=http://localhost:8080

# RabbitMQ connection URL. The bot publishes download job requests to the
# "video.jobs" queue and consumes completed file IDs from "video.completed".
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
